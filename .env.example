NEXT_PUBLIC_SUPABASE_URL=            # TODO_OWNER_CONFIGURATION: https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # TODO_OWNER_CONFIGURATION: chave anon/publishable do projeto
NEXT_PUBLIC_SITE_URL=                # TODO_OWNER_CONFIGURATION: https://seu-dominio (sem barra no fim)
NEXT_PUBLIC_CHECKOUT_URL_ACESSO_COMPLETO=   # TODO_OWNER_CONFIGURATION: https://pay.cakto.com.br/<ID_DA_OFERTA>
NEXT_PUBLIC_SUPPORT_EMAIL=           # TODO_OWNER_CONFIGURATION
NEXT_PUBLIC_META_PIXEL_ID=           # opcional
NEXT_PUBLIC_UTMIFY_PIXEL_ID=         # opcional

